{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 5
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "max_particles": 100,
        "spawn_rate": "math.clamp(10 * math.clamp(q.entity_size,1,2), 10, 100)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.sin(v.emitter_age*360*3+v.emitter_random_1*360)*(math.clamp(q.entity_size,1,2)+0.1)",
          "-math.max(q.entity_size,1) / 2.2",
          "math.cos(v.emitter_age*360*3+v.emitter_random_1*360)*(math.clamp(q.entity_size,1,2)+0.1)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          0.1,
          0.1
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "frames_per_second": 24,
            "loop": true,
            "max_frame": 4,
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              8
            ]
          },
          "texture_height": 32,
          "texture_width": 8
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFFF9BAF",
            "0.38": "#FFFFF864",
            "0.73": "#FFB63EFB",
            "1.0": "#006EFFEC"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(1,4) * 90"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          4,
          0
        ]
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle_yellow"
      },
      "identifier": "generations_core:mega_sparkle"
    }
  }
}
