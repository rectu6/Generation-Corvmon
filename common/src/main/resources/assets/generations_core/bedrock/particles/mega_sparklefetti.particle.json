{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "max_particles": "15 * math.clamp(q.entity_size,1,4)",
        "spawn_rate": "200 * math.clamp(q.entity_size,1,4)"
      },
      "minecraft:emitter_shape_disc": {
        "direction": [
          "math.random(-0.6,0.6)",
          "math.random(0.6,1)",
          "math.random(-0.6,0.6)"
        ],
        "offset": [
          0,
          0.1,
          0
        ],
        "radius": 0.1,
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "math.clamp(0.125 * math.clamp(q.entity_size,1,4), 0.075, 0.2)",
          "math.clamp(0.125 * math.clamp(q.entity_size,1,4), 0.075, 0.2)"
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "frames_per_second": 24,
            "loop": true,
            "max_frame": 2,
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ]
          },
          "texture_height": 32,
          "texture_width": 16
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFFF3B3B",
            "0.2": "#FFFF9A3B",
            "0.4": "#FFFFF03B",
            "0.6": "#FF4BFF6B",
            "0.8": "#FF3BB7FF",
            "1.0": "#FFB33BFF"
          },
          "interpolant": "v.particle_random_2"
        }
      },
      "minecraft:particle_initial_speed": "math.random(4,8) * math.clamp(q.entity_size,1,4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.particle_random_1 + 1.5"
