{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.3
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "max_particles": 100,
        "spawn_rate": 12
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "(6/128) * 1 * v.particle_age * math.clamp(q.entity_size,1,10)",
          "4 * v.particle_age * math.clamp(q.entity_size,1,10)"
        ],
        "uv": {
          "texture_height": 128,
          "texture_width": 6,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            6,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00FF3B3B",
            "0.17": "#FFFF9A3B",
            "0.34": "#FFFFF03B",
            "0.51": "#FF4BFF6B",
            "0.68": "#FF3BB7FF",
            "0.85": "#FFB33BFF",
            "1.0": "#00FF3BC8"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initial_spin": {
        "rotation": "v.emitter_age/v.emitter_lifetime*360*6 + v.emitter_age/v.emitter_lifetime*360*math.pi + v.emitter_random_1*360",
        "rotation_rate": "math.random(-20,20)"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_motion_dynamic": {}
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/lightbeam"
      },
      "identifier": "generations_core:mega_godrays"
    }
  }
}
