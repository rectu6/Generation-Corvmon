{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "generations_core:mega_symbols_rising",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "generations_core:textures/particles/mega_symbol"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 6,
        "max_particles": 20
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.6
      },
      "minecraft:emitter_shape_disc": {
        "radius": "math.clamp(q.entity_size, 1, 2) * 1.2",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * math.clamp(q.entity_size, 1, 2)",
          "0.12 * math.clamp(q.entity_size, 1, 2)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.15": "#FFFFFFFF",
            "0.75": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
}
