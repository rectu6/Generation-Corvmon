{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "0.5 * math.clamp(q.entity_size,1,2)"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "35 * math.clamp(q.entity_size,1,2)"
      },
      "minecraft:emitter_shape_sphere": {
        "direction": "outwards",
        "radius": "math.clamp(q.entity_size,1,2)/2",
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "0.125 * math.clamp(q.entity_size,1,2) + 0.1",
          "0.125 * math.clamp(q.entity_size,1,2) + 0.1"
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "frames_per_second": 30,
            "max_frame": 4,
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              8
            ],
            "stretch_to_lifetime": true
          },
          "texture_height": 32,
          "texture_width": 8
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00FF3B3B",
            "0.17": "#FFFF9A3B",
            "0.34": "#FFFFF03B",
            "0.51": "#FF4BFF6B",
            "0.68": "#FF3BB7FF",
            "0.85": "#FFB33BFF",
            "1.0": "#00FF3BC8"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": 18,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5,1)*1.75"
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 5,
        "collision_radius": 0.05
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "v.particle_random_1*12 - 6",
          "v.particle_random_2*12 - 6",
          "v.particle_random_3*12 - 6"
        ],
        "linear_drag_coefficient": 4
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle_yellow"
      },
      "identifier": "generations_core:mega_sparkleburst"
    }
  }
}
