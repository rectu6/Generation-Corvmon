{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.2
      },
      "minecraft:emitter_rate_steady": {
        "max_particles": 100,
        "spawn_rate": "8 * math.clamp(q.entity_size,1,2)"
      },
      "minecraft:emitter_shape_disc": {
        "direction": "outwards",
        "offset": [
          0,
          "math.random(-1,1) * math.clamp(q.entity_size,1,2)",
          0
        ],
        "radius": "math.clamp(q.entity_size,1,2) * 1.5 + math.random(0.2,1) * math.clamp(q.entity_size,1,2)",
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "0.3 * math.clamp(q.entity_size,1,4)",
          "0.3 * math.clamp(q.entity_size,1,4)"
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "max_frame": 6,
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ],
            "stretch_to_lifetime": true
          },
          "texture_height": 96,
          "texture_width": 16
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00FF3B3B",
            "0.17": "#FFFF9A3B",
            "0.34": "#FFFFF03B",
            "0.51": "#FF4BFF6B",
            "0.68": "#FF3BB7FF",
            "0.85": "#FFB33BFF",
            "1.0": "#00FF3BC8"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_motion_dynamic": {}
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/bigsparkle"
      },
      "identifier": "generations_core:mega_bigsparkle"
    }
