{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.8
      },
      "minecraft:emitter_rate_steady": {
        "max_particles": 100,
        "spawn_rate": "10 * (math.clamp(q.entity_size,1,2)/2) + 5"
      },
      "minecraft:emitter_shape_sphere": {
        "direction": "outwards",
        "radius": "math.clamp(q.entity_size,1,2)",
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "0.2 * math.clamp(q.entity_size,1,2)",
          "0.2 * math.clamp(q.entity_size,1,2)"
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "frames_per_second": 24,
            "loop": true,
            "max_frame": 4,
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              8
            ]
          },
          "texture_height": 32,
          "texture_width": 8
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00FF3B3B",
            "0.17": "#FFFF9A3B",
            "0.34": "#FFFFF03B",
            "0.51": "#FF4BFF6B",
            "0.68": "#FF3BB7FF",
            "0.85": "#FFB33BFF",
            "1.0": "#00FF3BC8"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": "math.random(4,6) * math.clamp(q.entity_size,1,2)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(1,4)*90"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 1,
        "collision_drag": 1
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/sparkle/glowingsparkle_yellow"
      },
      "identifier": "generations_core:mega_flyingsparkles"
    }
  }
}
