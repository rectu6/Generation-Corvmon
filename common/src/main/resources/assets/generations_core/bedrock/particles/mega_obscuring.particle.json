{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.4
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(350 * math.max(q.entity_size, 1), 10, 600) * (q.entity_size >= 2 ? 3 : 1.2)"
      },
      "minecraft:emitter_shape_sphere": {
        "direction": "inwards",
        "radius": "(math.clamp(q.entity_radius,0.1,3) * 3 / (q.entity_scale + (q.entity_scale <= 1 ? 0.3 : (q.entity_scale >= 1.79 ? 0.1 : 0.9))))",
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": [
          "0.175 * math.clamp(q.entity_size,1,2) * 1.5",
          "0.175 * math.clamp(q.entity_size,1,2) * 1.5"
        ],
        "uv": {
          "flipbook": {
            "base_UV": [
              0,
              40
            ],
            "frames_per_second": 3,
            "max_frame": 6,
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              -8
            ]
          },
          "texture_height": 48,
          "texture_width": 8
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.22": "#FFCCFFFC",
            "0.56": "#FFDCE5FE",
            "0.77": "#FFFADDFE",
            "1.0": "#FF86FBFF"
          },
          "interpolant": "v.particle_random_4"
        }
      },
      "minecraft:particle_initial_speed": "math.clamp(q.entity_size,0.5,2) * (q.entity_size >= 2 ? 5 : 10)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(1,4) * 90"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2.4
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.random(-1,1) * q.entity_size",
          "math.random(-1,1) * q.entity_size",
          "math.random(-1,1) * q.entity_size"
        ],
        "linear_drag_coefficient": "(q.entity_size >= 1.79 ? 18 : (q.entity_size <= 0.5 ? 8 : 10.5))"
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/smoke/glowingsmoke_cyan"
      },
      "identifier": "generations_core:mega_obscuring"
    }
  }
}
