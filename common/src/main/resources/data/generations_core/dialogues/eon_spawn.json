{
  "speakers": {
    "player": {
      "face": "q.player.face();",
      "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
  },
  "pages": [
    {
      "id": "intro",
      "lines": [
        "generations_core.dialogue.eon.intro"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "generations_core.dialogue.eon.latios",
            "value": "latios",
            "isVisible": "q.player.capped('cobblemon:latios')",
            "action": [
              "v.pokemon_name = 'Latios';",
              "v.pokemon_id = 'latios';",
              "q.dialogue.set_page('latios_1');"
            ]
          },
          {
            "text": "generations_core.dialogue.eon.latias",
            "value": "latias",
            "isVisible": "q.player.capped('cobblemon:latias')",
            "action": [
              "v.pokemon_name = 'Latias';",
              "v.pokemon_id = 'latias';",
              "q.dialogue.set_page('latias_1');"
            ]
          },
          {
            "text": "generations_core.dialogue.eon.none",
            "value": "none",
            "isVisible": "!q.player.capped('cobblemon:latios') && !q.player.capped('cobblemon:latias')",
            "action": [
              "q.dialogue.set_page('none_1');"
            ]
          }
        ]
      }
    },
    {
      "id": "latios_1",
      "lines": [ "generations_core.dialogue.eon.recall" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1
      }
    },
    {
      "id": "latios_2",
      "lines": [ "generations_core.dialogue.eon.latios_approach" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1
      }
    },
    {
      "id": "latios_3",
      "lines": [ "generations_core.dialogue.eon.latios_arrived" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1,
        "action": [
          "q.generations_eon_summon(q.player, 'latios level=65');",
          "q.dialogue.close();"
        ]
      }
    },
    {
      "id": "latias_1",
      "lines": [ "generations_core.dialogue.eon.recall" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1
      }
    },
    {
      "id": "latias_2",
      "lines": [ "generations_core.dialogue.eon.latias_approach" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1
      }
    },
    {
      "id": "latias_3",
      "lines": [ "generations_core.dialogue.eon.latias_arrived" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1,
        "action": [
          "q.generations_eon_summon(q.player, 'latias level=65');",
          "q.dialogue.close();"
        ]
      }
    },
    {
      "id": "none_1",
      "lines": [ "generations_core.dialogue.eon.recall" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1
      }
    },
    {
      "id": "none_2",
      "allowSkip": false,
      "lines": [ "generations_core.dialogue.eon.none_nothing" ],
      "input": {
        "type": "auto-continue",
        "allowSkip": false,
        "delay": 1,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}
